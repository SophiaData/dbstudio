# 依赖
node_modules/
.pnpm-store/

# 构建产物
out/
dist/

# 测试产物：夹具数据库是**生成出来的**，不应入库
# （`pnpm fixture` / 各 e2e 会重新生成）
tests/fixtures/*.db
tests/fixtures/*.db-*
# SSL 测试夹具是脚本生成的证书/私钥，绝不入库
tests/.ssl-fixture/

# 本地日志与临时文件
*.log
.DS_Store
*.tmp
.corrupt-*

# 编辑器
.vscode/
.idea/

# 环境变量（本项目当前不依赖，但防止将来误提交）
.env
.env.*
release/

# SDK 构建产物
sdk/dist/
sdk/.tmp-js/
sdk/*.tgz

# 误跑的 tsc 可能在源码目录生成声明文件，不应入库
src/**/*.d.ts

# GUI 测试截图（人工复核用，不入库）
out/gui-flow/

# 备份目录（可能含证书/私钥，绝不入库）
backups/
tests/.ssh-fixture/

# 临时/验证产物（手工清理时容易漏，显式忽略）
tmp-*/
verify-*/
# electron-builder 会把 renderer 入口复制到项目根，属构建产物
/index.html

# Native Rust/Tauri build outputs
/target/
/src-tauri/target/
/src-tauri/gen/
