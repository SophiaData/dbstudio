{
  "name": "dbstudio",
  "version": "0.3.1",
  "description": "数据库客户端（Electron + TypeScript）。架构源自对 DBeaver 源码的剖析：驱动进程隔离、虚拟化元数据树、游标分页结果集、参数化在线编辑。",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm run build:driver-host && electron-vite dev",
    "build:driver-host": "node scripts/build-driver-host.mjs",
    "build": "pnpm run build:driver-host && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fixture": "node scripts/make-fixture.mjs",
    "test": "node tests/e2e.mjs",
    "test:resultset": "node tests/e2e-resultset.mjs",
    "test:edit": "node tests/e2e-edit.mjs",
    "test:electron": "node scripts/run-in-electron.mjs scripts/acceptance.mjs",
    "test:gui": "node scripts/run-in-electron.mjs --gui",
    "test:gui:headless": "DBSTUDIO_TEST_HIDDEN=1 pnpm test:gui",
    "test:gui-hidden": "node tests/gui-hidden-mode.mjs",
    "verify:headless": "DBSTUDIO_TEST_HIDDEN=1 node scripts/verify.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:node": "node scripts/verify.mjs node",
    "verify:gui": "node scripts/verify.mjs gui",
    "verify:external": "node scripts/verify.mjs external",
    "verify:ci": "node scripts/verify.mjs --require-external",
    "test:persist": "node tests/e2e-persist.mjs",
    "build:app": "pnpm run build && electron-builder --config electron-builder.config.mjs",
    "build:app:mac": "pnpm run build && electron-builder --config electron-builder.config.mjs --mac",
    "build:app:linux": "pnpm run build && electron-builder --config electron-builder.config.mjs --linux",
    "build:app:win": "pnpm run build && electron-builder --config electron-builder.config.mjs --win",
    "build:sdk": "cd sdk && node build.mjs",
    "test:sdk": "cd sdk && node test/sdk.e2e.mjs",
    "test:sdk-package": "node tests/e2e-sdk-package.mjs",
    "test:connection-lifecycle": "node tests/e2e-connection-lifecycle.mjs",
    "test:postgres-edits": "node tests/e2e-postgres-edits.mjs",
    "test:verify-manifest": "node tests/e2e-verify-manifest.mjs",
    "test:gui-flow": "node tests/gui-flow.mjs",
    "test:mutations": "node tests/e2e-mutations.mjs",
    "test:gui-features": "node tests/gui-features.mjs",
    "test:ddl": "node tests/e2e-ddl.mjs",
    "test:gui-round3": "node tests/gui-round3.mjs",
    "test:postgres": "node tests/e2e-postgres.mjs",
    "test:cancel": "node tests/e2e-cancel.mjs",
    "test:postgres-ssl": "node tests/e2e-postgres-ssl.mjs",
    "test:ssh-tunnel": "node tests/e2e-ssh-tunnel.mjs",
    "ssh-fixture": "node scripts/make-ssh-fixture.mjs tests/.ssh-fixture",
    "ssl-fixture": "node scripts/make-ssl-fixture.mjs tests/.ssl-fixture",
    "test:gui-ssl-form": "node tests/gui-ssl-form.mjs",
    "test:gui-ssh-form": "node tests/gui-ssh-form.mjs",
    "test:gui-layout": "node tests/gui-layout.mjs",
    "check:build": "bash scripts/check-build-fresh.sh",
    "test:gui-sql": "node tests/gui-sql-editor.mjs",
    "test:sql-library": "node tests/e2e-sql-library.mjs",
    "test:gui-sql-library": "node tests/gui-sql-library.mjs",
    "test:gui-tab-context": "node tests/gui-tab-context.mjs",
    "test:gui-export-integrity": "node tests/gui-export-integrity.mjs",
    "test:gui-transaction-lifecycle": "node tests/gui-transaction-lifecycle.mjs",
    "test:gui-mutation-transaction": "node tests/gui-mutation-transaction.mjs",
    "test:gui-grid-lifecycle": "node tests/gui-grid-lifecycle.mjs",
    "test:gui-app-close-guard": "node tests/gui-app-close-guard.mjs",
    "test:gui-connection-guard": "node tests/gui-connection-guard.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/pg": "^8.23.1",
    "@types/ssh2": "^1.15.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "author": "SophiaData",
  "license": "MIT",
  "homepage": "https://github.com/SophiaData/dbstudio",
  "repository": {
    "type": "git",
    "url": "https://github.com/SophiaData/dbstudio.git"
  },
  "bugs": {
    "url": "https://github.com/SophiaData/dbstudio/issues"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "ssh2": "^1.17.0"
  }
}
