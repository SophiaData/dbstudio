{
  "name": "dbstudio",
  "version": "0.8.1",
  "description": "本地数据库客户端（Tauri + Vue + Rust）：独立业务核心、原生数据库驱动、元数据浏览、SQL、事务编辑与数据传输。",
  "main": "out/main/index.js",
  "scripts": {
    "dev:desktop": "vite --config apps/desktop/vite.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/build-native-desktop.mjs",
    "test:native": "cargo test --workspace --exclude dbstudio-desktop",
    "test:native-architecture": "node scripts/check-native-architecture.mjs",
    "test:native-desktop": "node scripts/native-desktop-smoke.mjs",
    "test:native-release": "node tests/native-release-gate.mjs",
    "test:native-test-output": "node --test scripts/native-test-output.test.mjs",
    "test:native-host": "node scripts/native-host-test-gate.mjs",
    "test:native-host-gate": "node --test scripts/native-host-test-gate.test.mjs",
    "dev": "tauri dev",
    "build": "node scripts/build-native-desktop.mjs",
    "start:http-server": "node scripts/start-http-server.mjs",
    "preview": "tauri dev",
    "fixture": "node scripts/make-fixture.mjs",
    "test": "cargo test --workspace --exclude dbstudio-desktop",
    "verify:headless": "DBSTUDIO_TEST_HIDDEN=1 node scripts/verify.mjs",
    "verify": "pnpm test:native-architecture && pnpm typecheck && pnpm test:native-ui-models && pnpm test:native && pnpm test:native-release && pnpm test:native-test-output",
    "verify:node": "node scripts/verify.mjs node",
    "verify:gui": "node scripts/verify.mjs gui",
    "verify:external": "node scripts/verify.mjs external",
    "verify:ci": "node scripts/verify.mjs --require-external",
    "build:app": "node scripts/build-native-desktop.mjs",
    "build:app:mac": "node scripts/build-native-desktop.mjs --bundles app,dmg --target aarch64-apple-darwin",
    "build:app:linux": "node scripts/build-native-desktop.mjs --bundles deb,appimage",
    "build:app:win": "node scripts/build-native-desktop.mjs --bundles nsis --target x86_64-pc-windows-msvc",
    "test:sql-script-parser": "node tests/e2e-sql-script-parser.mjs",
    "test:verify-manifest": "node tests/e2e-verify-manifest.mjs",
    "check:bundle-boundaries": "vite build --config apps/desktop/vite.config.ts && node scripts/check-bundle-boundaries.mjs",
    "test:backend-contract": "node tests/e2e-backend-contract.mjs",
    "test:backend-client-selection": "node tests/e2e-backend-client-selection.mjs",
    "test:http-transport": "node tests/e2e-http-transport.mjs",
    "test:artifact-contract": "node tests/e2e-artifact-contract.mjs",
    "test:remote-contract": "node tests/e2e-remote-contract.mjs",
    "test:remote-connection-contract": "node tests/e2e-remote-connection-contract.mjs",
    "test:api-surface": "node tests/e2e-api-surface.mjs",
    "test:ddl-preview": "node tests/e2e-ddl-preview.mjs",
    "check:build": "bash scripts/check-build-fresh.sh",
    "test:verify-runner": "node tests/e2e-verify-runner.mjs",
    "test:release-gate": "node tests/e2e-release-gate.mjs",
    "test:packaged-smoke": "node tests/e2e-packaged-smoke.mjs",
    "test:core-unit": "vitest run",
    "test:sql-parameters-parser": "node tests/e2e-sql-parameters-parser.mjs",
    "test:import-validation": "node tests/e2e-import-validation.mjs",
    "test:er-relations": "node tests/e2e-er-relations.mjs",
    "test:er-layout": "node tests/e2e-er-layout.mjs",
    "test:structure-compare": "node tests/e2e-structure-compare.mjs",
    "test:data-compare": "node tests/e2e-data-compare.mjs",
    "test:native-ui-models": "node apps/desktop/tests/pure-regressions.mjs && node apps/desktop/tests/sql-workflow-regressions.mjs && node apps/desktop/tests/grid-workflow-regressions.mjs && node apps/desktop/tests/audit-ui-regressions.mjs && node apps/desktop/tests/editor-regressions.mjs",
    "build:desktop": "vue-tsc --noEmit -p apps/desktop/tsconfig.json && vite build --config apps/desktop/vite.config.ts",
    "typecheck:desktop": "vue-tsc --noEmit -p apps/desktop/tsconfig.json",
    "typecheck": "vue-tsc --noEmit -p apps/desktop/tsconfig.json && tsc --noEmit -p tsconfig.json",
    "check:typecheck": "pnpm run typecheck",
    "typecheck:core": "tsc --noEmit -p tsconfig.json",
    "ssh-fixture": "node scripts/make-ssh-fixture.mjs tests/.ssh-fixture",
    "ssl-fixture": "node scripts/make-ssl-fixture.mjs tests/.ssl-fixture"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.9.0",
    "@types/pg": "^8.23.1",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "author": "SophiaData",
  "license": "MIT",
  "homepage": "https://github.com/SophiaData/dbstudio",
  "repository": {
    "type": "git",
    "url": "https://github.com/SophiaData/dbstudio.git"
  },
  "bugs": {
    "url": "https://github.com/SophiaData/dbstudio/issues"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "ioredis": "^5.11.1",
    "jose": "^6.2.15",
    "kafkajs": "^2.2.4",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "ssh2": "^1.17.0",
    "vue": "^3.5.44"
  }
}
